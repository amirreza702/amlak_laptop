# Build مرحله‌ای خروجی استاتیک Next.js برای PWA
FROM node:20-alpine AS builder

WORKDIR /app

COPY package*.json ./
RUN npm install

COPY . .

# این مقدار داخل کد مرورگر قرار می‌گیرد؛ باید از مرورگر قابل دسترسی باشد.
ARG NEXT_PUBLIC_API_URL=
ENV NEXT_PUBLIC_API_URL=${NEXT_PUBLIC_API_URL}

RUN npm run build

# سرو کردن فایل‌های استاتیک و مسیرهای /property/:id با fallback
FROM nginx:1.27-alpine

COPY nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=builder /app/out /usr/share/nginx/html

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
