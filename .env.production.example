# Copy this file to .env.production and replace every placeholder.
# Keep .env.production private; never commit real credentials.

POSTGRES_USER=postgres
POSTGRES_PASSWORD=REPLACE_WITH_A_LONG_RANDOM_PASSWORD
POSTGRES_DB=amlak

# The password in DATABASE_URL must be URL-encoded if it contains reserved URL characters.
DATABASE_URL=postgresql://postgres:REPLACE_WITH_A_LONG_RANDOM_PASSWORD@db:5432/amlak?schema=public

# Public origins, without trailing slash; separate multiple origins with commas.
CORS_ORIGINS=https://your-domain.example
NEXT_PUBLIC_API_URL=https://api.your-domain.example

FRONTEND_PORT=3000
BACKEND_PORT=4000
